{# comments #}
{#- The PDF has no comments. -#}
{%- if not view_object.document_type.is_pdf() %}
{# needs sdoc_entity, see README.txt #}

{% if view_object.project_config.is_activated_comments() %}
  {%- if view_object.current_view.includes_field(sdoc_entity.node_type, "COMMENT") and view_object.node_supports_comments(sdoc_entity) %}
    {%- with
      node_mid=sdoc_entity.reserved_mid.get_string_value(),
      items=view_object.comment_panel_items(sdoc_entity),
      interactive=view_object.is_running_on_server
    -%}
      {%- include "features/comments/panel.jinja.html" -%}
    {%- endwith -%}
  {%- endif %}
{% elif view_object.current_view.includes_field(sdoc_entity.node_type, "COMMENT") %}
  {%- for comment_field_ in sdoc_entity.get_comment_fields() %}
    <sdoc-node-field-label>{{ sdoc_entity.get_field_human_title("COMMENT") }}:</sdoc-node-field-label>
    <sdoc-node-field
      data-field-label="comment"
    >
      {%- with field_content = view_object.render_node_field(comment_field_) -%}
        {%- include "components/field/index.jinja" -%}
      {%- endwith -%}
    </sdoc-node-field>
  {%- endfor %}
  {{ view_object.render_issues(sdoc_entity, field="COMMENT") }}
{%- endif %}
{%- endif %}
