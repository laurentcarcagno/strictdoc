{% set template_type = view_object.error_code %}

{% extends "base.jinja.html" %}

{% block head_css %}
  {{ super() }}
{% endblock head_css %}

{% block head_scripts %}

{% endblock head_scripts %}

{% block title %}
  {{ view_object.project_config.project_title }} - {{ template_type }}
{% endblock title %}

{% block viewtype %}error-page{% endblock viewtype %}

{% block layout_nav %}
  {% include "_shared/nav.jinja.html" %}
{% endblock layout_nav %}

{% block toc_content %}
{% endblock toc_content %}

{% block header_content %}
  {%- with
      header__pagetype=template_type
  -%}
    {% include "components/header/index.jinja" %}
  {%- endwith -%}
{% endblock header_content %}

{% block main_content %}
  <div class="main">
    <sdoc-main-placeholder
      style="height: 100%;"
      data-testid="error-{{ view_object.error_code }}"
    >
      <span class="sdoc-main-placeholder__icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24"><path d="M6 2.5h8l4 4v15H6z M14 2.5v4h4 M9.5 12.5l5 5 M14.5 12.5l-5 5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></span>
      <span class="hem-eyebrow">Error {{ view_object.error_code }}</span>
      <h1>{{ view_object.get_error_title() }}</h1>
      <p>{{ view_object.get_error_text() }}</p>
      <a href="{{ view_object.render_url('index.html') }}" data-testid="error-home-page-link">{{ _("Go to home page") }}</a>
    </sdoc-main-placeholder>
  </div>
{% endblock main_content %}
