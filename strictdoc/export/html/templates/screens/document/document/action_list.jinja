<a
  href="/actions/document/edit_grammar?document_mid={{ view_object.document.reserved_mid }}"
  class="dropdown_menu_item"
  data-turbo="true"
  data-turbo-action="replace"
  title="{{ _("Edit document grammar") }}"
  data-testid="document-edit-grammar-action"
  role="menuitem"
>{% include "icons/ico16_gear.svg" %} Edit grammar</a>

{%- if view_object.project_config.is_activated_html2pdf() -%}
<a
  class="dropdown_menu_item"
  href="/export_html2pdf/{{ view_object.document.reserved_mid }}"
  data-testid="document-export-html2pdf-action"
  role="menuitem"
>{% include "icons/ico16_export.svg" %} Export to PDF</a>
{%- endif -%}

{%- if view_object.project_config.is_activated_html2pdf() and view_object.project_config.is_activated_git() -%}
<a
  class="dropdown_menu_item"
  href="/export_html2pdf/{{ view_object.document.reserved_mid }}?revision_marks=false"
  data-testid="document-export-html2pdf-clean-action"
  role="menuitem"
>{% include "icons/ico16_export.svg" %} {{ _("Export to PDF without revision marks") }}</a>
{%- endif -%}

{%- if view_object.project_config.is_activated_reqif() -%}
<a
  class="dropdown_menu_item"
  href="/reqif/export_document/{{ view_object.document.reserved_mid }}"
  data-testid="document-export-reqif-action"
  role="menuitem"
>{% include "icons/ico16_export.svg" %} Export to ReqIF</a>
{%- endif -%}

{%- if view_object.project_config.is_running_on_server and view_object.project_config.is_activated_git() -%}
<a
  class="dropdown_menu_item"
  href="/actions/git/overview"
  data-turbo="true"
  title="{{ _("Versions, tags and push of the document repositories") }}"
  data-testid="document-git-action"
  role="menuitem"
>{{ _("Configuration management") }}</a>
{%- endif -%}

<a
  class="dropdown_menu_item"
  href="/actions/document/delete_document?document_mid={{ view_object.document.reserved_mid }}"
  data-turbo="true"
  data-turbo-method="delete"
  title="{{ _("Delete document") }}"
  data-testid="document-delete-action"
  role="menuitem"
>{{ _("Delete document") }}</a>
