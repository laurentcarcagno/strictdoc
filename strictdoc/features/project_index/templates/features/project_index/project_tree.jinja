{#- On the server the tree lives in the sidebar (sidebar_tree.jinja.html): the actions that change the tree replace it there. -#}
{%- if view_object.project_config.is_running_on_server -%}
  {% include "features/project_index/sidebar_tree.jinja.html" %}
{%- else -%}
{%- if not view_object.is_empty_tree() -%}
  <div class="project_tree" js-collapsible_tree>
    {% for root_tree_ in view_object.document_tree_iterator.document_tree.file_tree %}

      {% if root_tree_.root_folder_or_file.is_folder() %}
        {% if view_object.should_display_folder(root_tree_.root_folder_or_file) %}
          {% with folder = root_tree_.root_folder_or_file %}
            {% include "features/project_index/project_tree_folder.jinja" %}
          {% endwith %}
        {% endif %}
      {% else %}
        {% if view_object.should_display_file(root_tree_.root_folder_or_file) %}
          {% with file = root_tree_.root_folder_or_file %}
            {% include "features/project_index/project_tree_file.jinja" %}
          {% endwith %}
        {% endif %}
      {% endif %}

    {% endfor %}
  </div>
{%- else -%}
  <span data-testid="document-tree-empty-text">{{ _("The document tree has no documents yet.") }}</span>
{%- endif -%}

{%- endif -%}
