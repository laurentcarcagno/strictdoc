<a
  class="dropdown_menu_item"
  href="/actions/project_index/new_document"
  data-turbo="true"
  title="{{ _("Add new document") }}"
  data-testid="tree-add-document-action"
  role="menuitem"
>{% include "icons/ico16_add.svg" %} Add document</a>

<a
  class="dropdown_menu_item"
  href="/actions/project_index/new_folder"
  data-turbo="true"
  title="{{ _("Add new folder") }}"
  data-testid="tree-add-folder-action"
  role="menuitem"
>{% include "icons/ico16_folder.svg" %} {{ _("Add folder") }}</a>

<a
  class="dropdown_menu_item"
  href="/actions/project_index/edit_project_title_form"
  data-turbo="true"
  title="{{ _("Edit project title") }}"
  data-testid="project-edit-title-action"
  role="menuitem"
>{{ _("Edit project title") }}</a>

{%- if view_object.project_config.is_activated_reqif() -%}
<a
  class="dropdown_menu_item"
  href="/actions/project_index/import_reqif_document_form"
  data-turbo="true"
  title="{{ _("Import document tree from ReqIF") }}"
  data-testid="tree-import-reqif-action"
  role="menuitem"
>{% include "icons/ico16_import.svg" %} Import from ReqIF</a>

{%- if not view_object.is_empty_tree() -%}
<a
  class="dropdown_menu_item"
  href="/reqif/export_tree"
  title="{{ _("Export document tree to ReqIF") }}"
  data-testid="tree-export-reqif-action"
  role="menuitem"
>{% include "icons/ico16_export.svg" %} Export to ReqIF</a>
{%- endif -%}
{%- endif -%}

{%- if view_object.project_config.is_activated_docx() -%}
<a
  class="dropdown_menu_item"
  href="/actions/project_index/import_docx_form"
  data-turbo="true"
  title="{{ _("Import a Word document") }}"
  data-testid="tree-import-docx-action"
  role="menuitem"
>{% include "icons/ico16_import.svg" %} Import from Word</a>

{%- if not view_object.is_empty_tree() -%}
<a
  class="dropdown_menu_item"
  href="/actions/project_index/export_docx_form"
  data-turbo="true"
  title="{{ _("Export a document to Word") }}"
  data-testid="tree-export-docx-action"
  role="menuitem"
>{% include "icons/ico16_export.svg" %} Export to Word</a>
{%- endif -%}
{%- endif -%}

{%- if view_object.project_config.is_running_on_server and view_object.project_config.is_activated_git() -%}
<a
  class="dropdown_menu_item"
  href="/git"
  title="{{ _("Versions, tags and push of the document repositories") }}"
  data-testid="tree-git-action"
  role="menuitem"
>{{ _("Configuration management") }}</a>
{%- endif -%}
