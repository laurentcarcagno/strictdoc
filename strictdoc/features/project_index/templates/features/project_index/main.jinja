<div class="main">
  <div class="dashboard">
    <div class="dashboard-main">
      {%- if view_object.project_config.is_running_on_server %}
      <p class="dashboard-hint" data-testid="dashboard-tree-hint">{{ _("The project tree is in the left bar. Click a document to open it; a right click on the project, a folder or a document opens its menu.") }}</p>
      {%- else %}
      {% include "features/project_index/frame_project_tree.jinja.html" %}
      {%- endif %}
    </div>
    <div class="dashboard-aside">
      {% if view_object.should_display_fragments_toggle() %}
      <div class="dashboard-block" id="project_tree_controls">{# must to be empty #}</div>
      {% endif %}
      {%- include "components/switch/index.jinja" -%}

      <div class="dashboard-block">
        {# {{ view_object.project_config.project_title }} #}
        {# ⛭ ⚙️ #}
        <div class="dashboard-block-title">
          {{ _("Project tree configuration") }}
        </div>

        {% if view_object.project_config.input_paths|length %}
          <b>{{ _("Input paths:") }}</b>
          {% for path_ in view_object.project_config.input_paths %}
          {% set external_, internal_ = view_object.split_path_for_display(path_) %}
          <code class="dashboard-path" data-testid="dashboard-input-path">
            {%- if external_ -%}
            <span class="dashboard-path-external" data-testid="dashboard-input-path-external" tabindex="0" title="{{ _("Click to reveal") }}">…</span><span class="dashboard-path-external-full">{{ external_ }}</span>
            {%- endif -%}
            <span class="dashboard-path-internal">{{ internal_ }}</span>
          </code><br/>
          {% endfor %}
        {% endif %}

        {% if view_object.project_config.include_doc_paths|length or view_object.project_config.exclude_doc_paths|length %}
          <p>{{ _("Document paths:") }}</p>
          <ul>
            {% for path_ in view_object.project_config.include_doc_paths %}
            <li style="list-style-type: '✔️    '">{{ path_ }}</li>
            {% endfor %}
            {% for path_ in view_object.project_config.exclude_doc_paths %}
            <li style="list-style-type: '⛔    '">{{ path_ }}</li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if view_object.project_config.source_root_path is not none %}
          {% set external_, internal_ = view_object.split_path_for_display(view_object.project_config.source_root_path) %}
          <b>{{ _("Source root path:") }}</b>
            <code class="dashboard-path" data-testid="dashboard-source-root-path">
              {%- if external_ -%}
              <span class="dashboard-path-external" data-testid="dashboard-source-root-path-external" tabindex="0" title="{{ _("Click to reveal") }}">…</span><span class="dashboard-path-external-full">{{ external_ }}</span>
              {%- endif -%}
              <span class="dashboard-path-internal">{{ internal_ }}</span>
            </code>
        {% endif %}

        {% if view_object.project_config.include_source_paths|length or view_object.project_config.exclude_source_paths|length %}
          <p>{{ _("Source paths:") }}</p>
          <ul>
            {% for path_ in view_object.project_config.include_source_paths %}
            <li style="list-style-type: '✔️    '">{{ path_ }}</li>
            {% endfor %}
            {% for path_ in view_object.project_config.exclude_source_paths %}
            <li style="list-style-type: '⛔    '">{{ path_ }}</li>
            {% endfor %}
          </ul>
        {% endif %}

      </div>
    </div>
  </div>
</div>
