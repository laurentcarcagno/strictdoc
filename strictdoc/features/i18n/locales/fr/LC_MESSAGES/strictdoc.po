"<b>Text search</b>: enter words or phrases to search across "
"requirement/section fields and source file paths."
msgstr ""
"<b>Recherche textuelle</b> : des mots ou des phrases, cherchés dans les "
"champs des exigences et des sections et dans les chemins des fichiers "
"source."

#: strictdoc/features/search/templates/features/search/legend.jinja:15
msgid "<code>\"foo bar\"</code> matches the exact phrase <code>foo bar</code>."
msgstr "<code>\"foo bar\"</code> trouve la phrase exacte <code>foo bar</code>."

#: strictdoc/features/search/templates/features/search/legend.jinja:24
msgid ""
"<code>and</code> and <code>or</code> expressions must be grouped using round"
" brackets."
msgstr ""
"Les expressions <code>and</code> et <code>or</code> se groupent entre "
"parenthèses."

#: strictdoc/features/search/templates/features/search/legend.jinja:14
msgid ""
"<code>foo bar</code> matches like <code>.*foo.*bar.*</code> (ordered words "
"with wildcard gaps)."
msgstr ""
"<code>foo bar</code> trouve comme <code>.*foo.*bar.*</code> (mots dans "
"l'ordre, séparés par n'importe quel texte)."

#: strictdoc/features/tree_map/templates/features/tree_map/tips.jinja:16
