<sdoc-main-legend
  data-testid="search-main-legend"
>
    <p>{{ _("StrictDoc supports two search modes:") }}</p>
    <ol>
      <li>{% trans trimmed %}<b>Text search</b>: enter words or phrases to search across requirement/section fields and source file paths.{% endtrans %}</li>
      <li>
        {% trans trimmed %}<b>Query syntax</b>: use the grammar-based query language for precise filtering.{% endtrans %}
        <br>{% trans trimmed %}If the input contains query markers, StrictDoc parses it as a query and reports an error if parsing fails.{% endtrans %}
      </li>
    </ol>
    <p>{{ _("Text search syntax:") }}</p>
    <ul>
      <li>{% trans trimmed %}<code>foo bar</code> matches like <code>.*foo.*bar.*</code> (ordered words with wildcard gaps).{% endtrans %}</li>
      <li>{% trans trimmed %}<code>"foo bar"</code> matches the exact phrase <code>foo bar</code>.{% endtrans %}</li>
    </ul>

    <p>{{ _("Query syntax rules:") }}</p>
    <ul>
      <li>
        {% trans trimmed %}Every query component shall start with <code>node.</code>.{% endtrans %}
      </li>
      <li>
        {% trans trimmed %}<code>and</code> and <code>or</code> expressions must be grouped using round brackets.{% endtrans %}
      </li>
      <li>
        {{ _("Only double quotes are accepted for strings.") }}
      </li>
    </ul>
    <p>{{ _("Examples:") }}</p>
    <div class="sdoc-table_key_value">
      <a
        class="sdoc-table_key_value-key"
        data-testid="node.is_requirement"
        href="{{ view_object.render_url('search?q=node.is_requirement') }}"
      >
        <code>node.is_requirement</code>
      </a>
      <div class="sdoc-table_key_value-value">{{ _("Find all requirements.") }}</div>
      <a
        class="sdoc-table_key_value-key"
        data-testid="node.is_section"
        href="{{ view_object.render_url('search?q=node.is_section') }}"
      >
        <code>node.is_section</code>
      </a>
      <div class="sdoc-table_key_value-value">{{ _("Find all sections.") }}</div>
      <a
        class="sdoc-table_key_value-key"
        href="{{ view_object.render_url('search?q=(node.is_requirement and "System" in node["TITLE"])') }}"
        data-testid="node_is_title_system"
      >
        <code>
        (node.is_requirement and "System" in node["TITLE"])</code>
      </a>
      <div class="sdoc-table_key_value-value">{{ _("Find all requirements with a TITLE that equals to \"System\".") }}</div>
      <a class="sdoc-table_key_value-key" href="{{ view_object.render_url('search?q=(node.is_requirement and node.is_root)') }}"><code>(node.is_requirement and node.is_root)</code></a>
      <div class="sdoc-table_key_value-value">{{ _("Find all root requirements.") }}</div>
      <a class="sdoc-table_key_value-key" href="{{ view_object.render_url('search?q=(node.is_requirement and node.has_parent_requirements)') }}"><code>(node.is_requirement and node.has_parent_requirements)</code></a>
      <div class="sdoc-table_key_value-value">{{ _("Find all requirements which have parent requirements.") }}</div>
    </div>
    <p>{{ _("See the User Guide's section \"Query engine\" for more details.") }}</p>
</sdoc-main-legend>
