RUN: cd "%strictdoc_root/" && %strictdoc export "%strictdoc_root/" --formats=markdown --output-dir="%T/"

RUN: %diff "%strictdoc_root/docs/strictdoc_01_user_guide.md" "%T/markdown/docs/strictdoc_01_user_guide.md"
RUN: %diff "%strictdoc_root/docs/strictdoc_02_feature_map.md" "%T/markdown/docs/strictdoc_02_feature_map.md"
RUN: %diff "%strictdoc_root/docs/strictdoc_03_faq.md" "%T/markdown/docs/strictdoc_03_faq.md"
# _: %diff "%strictdoc_root/docs/strictdoc_21_l2_high_level_requirements.md" "%T/markdown/docs/strictdoc_21_l2_high_level_requirements.md"
# _: %diff "%strictdoc_root/docs/strictdoc_24_development_plan.md" "%T/markdown/docs/strictdoc_24_development_plan.md"
# _: %diff "%strictdoc_root/docs/strictdoc_25_design.md" "%T/markdown/docs/strictdoc_25_design.md"
